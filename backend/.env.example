# Copy this file to "backend/.env" and fill in the values.

# ---------- REQUIRED ----------
# MongoDB connection string
#   Local MongoDB:     mongodb://127.0.0.1:27017/quizapp
#   MongoDB Atlas:     mongodb+srv://<user>:<password>@<cluster>.mongodb.net/quizapp
MONGO_URI=mongodb://127.0.0.1:27017/quizapp

# Any long random text. Used to sign login tokens. Keep it secret.
JWT_SECRET=change-me-to-a-long-random-string

# ---------- OPTIONAL ----------
# Port of the backend (5000 is taken by AirPlay on macOS, so we use 5001)
PORT=5001

# Groq AI key for "Ask AI" and "Generate quiz from PDF" (free: https://console.groq.com/keys)
GROQ_API_KEY=
# Optional: which AI model to use first (default: openai/gpt-oss-20b)
# GROQ_MODEL=

# Redis cache. Leave empty to run WITHOUT cache (the app works the same, just a bit slower).
#   Local Redis:   redis://127.0.0.1:6379
#   Upstash/Render: rediss://default:<password>@<host>:6379
REDIS_URL=

# Optional: allow another frontend URL to call the API
# FRONTEND_URL=https://another-frontend.example.com   (the deployed frontend is already allowed)
